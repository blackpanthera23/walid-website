{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Walid Child",
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "brand-navy", "name": "Brand navy", "color": "#232B8F" },
				{ "slug": "brand-deep", "name": "Brand deep", "color": "#161B5E" },
				{ "slug": "brand-mid", "name": "Brand mid", "color": "#3A43B0" },
				{ "slug": "brand-soft", "name": "Brand soft", "color": "#EEF0FB" },
				{ "slug": "action-green", "name": "Action green", "color": "#1E8E66" },
				{ "slug": "action-green-dark", "name": "Action green dark", "color": "#176F50" },
				{ "slug": "whatsapp", "name": "WhatsApp green", "color": "#25D366" },
				{ "slug": "gold", "name": "Gold accent", "color": "#C9A227" },
				{ "slug": "gold-soft", "name": "Gold soft", "color": "#F6EFD6" },
				{ "slug": "ink", "name": "Ink", "color": "#1A1D2E" },
				{ "slug": "muted", "name": "Muted", "color": "#5B607A" },
				{ "slug": "rule", "name": "Rule", "color": "#DDE0EC" },
				{ "slug": "canvas", "name": "Canvas", "color": "#F8F9FC" },
				{ "slug": "surface", "name": "Surface", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Fraunces",
					"fontFamily": "\"Fraunces\", Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "\"Inter\", system-ui, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.1rem" },
				{ "slug": "large", "name": "Large", "size": "1.5rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "2.3rem" },
				{ "slug": "xx-large", "name": "Huge", "size": "clamp(2rem, 5vw, 3.4rem)" }
			]
		},
		"layout": {
			"contentSize": "1140px",
			"wideSize": "1280px"
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--canvas)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "17px",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				},
				"color": { "text": "var(--wp--preset--color--brand-deep)" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--brand-mid)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--action-green)",
					"text": "#ffffff"
				},
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "24px", "right": "24px" } }
			}
		}
	}
}
